---
const launchTargets = [
  {
    title: "eHealth Portal",
    description: "Open the clinical portal used by healthcare providers for patient access and care workflows.",
    role: "HealthcareProvider",
    url: import.meta.env.PUBLIC_EHEALTH_PORTAL_URL ?? "",
  },
  {
    title: "OpenNCP Manager",
    description: "Launch medication and prescription operations for pharmacy workflows.",
    role: "Pharmacist",
    url: import.meta.env.PUBLIC_OPENNCP_MANAGER_URL ?? "",
  },
  {
    title: "Administration",
    description: "Manage operational settings, launch governance tools, and handle privileged tasks.",
    role: "Admin",
    url: import.meta.env.PUBLIC_ADMIN_PORTAL_URL ?? "",
  },
  {
    title: "Reports",
    description: "Review reporting dashboards, activity insights, and access summaries.",
    role: "Reports",
    url: import.meta.env.PUBLIC_REPORTS_URL ?? "",
  },
];
---

<section class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
  <div class="panel rounded-[1.75rem] p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--brand)]">Available destinations</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">Systems you can open</h2>
      </div>
      <span class="rounded-full bg-[var(--brand-soft)] px-3 py-1 text-xs font-medium text-[var(--brand)]" id="role-count">0 roles detected</span>
    </div>

    <p class="mt-3 text-sm leading-6 text-[var(--text-muted)]" id="launch-summary">
      Sign in to resolve your Entra app roles and unlock the systems assigned to your account.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2" id="launch-grid">
      {launchTargets.map((target) => (
        <article
          class="hidden rounded-[1.5rem] border border-[var(--line)] bg-[var(--surface-muted)] p-5 transition duration-200 hover:border-[var(--brand)]/35 hover:bg-white"
          data-launch-card
          data-role={target.role}
          data-url={target.url}
        >
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--brand)]">{target.role}</p>
          <h3 class="mt-3 text-lg font-semibold text-slate-900">{target.title}</h3>
          <p class="mt-2 text-sm leading-6 text-[var(--text-muted)]">{target.description}</p>
          <button
            class="mt-5 inline-flex rounded-full bg-[var(--brand)] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#0b5a9c]"
            type="button"
          >
            Open destination
          </button>
        </article>
      ))}
    </div>
  </div>

  <aside class="panel rounded-[1.75rem] p-6">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--brand)]">Access model</p>
    <h2 class="mt-2 text-2xl font-semibold text-slate-900">How access is decided</h2>
    <div class="mt-5 space-y-4 text-sm leading-6 text-[var(--text-muted)]">
      <div class="rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-muted)] px-4 py-4">
        <p class="font-medium text-slate-900">1. Authenticate</p>
        <p class="mt-1">The browser signs the user in with Microsoft Entra ID using the MSAL public client flow.</p>
      </div>
      <div class="rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-muted)] px-4 py-4">
        <p class="font-medium text-slate-900">2. Read roles</p>
        <p class="mt-1">The dashboard inspects <span class="font-mono text-xs">idTokenClaims.roles</span> from the active account.</p>
      </div>
      <div class="rounded-[1.25rem] border border-[var(--line)] bg-[var(--surface-muted)] px-4 py-4">
        <p class="font-medium text-slate-900">3. Filter destinations</p>
        <p class="mt-1">Only configured destinations matching those roles are rendered as launch actions.</p>
      </div>
    </div>

    <div class="mt-6 rounded-[1.25rem] border border-[var(--line)] bg-white p-4">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--brand)]">Supported roles</p>
      <div class="mt-3 flex flex-wrap gap-2 text-sm text-slate-900">
        <span class="rounded-full bg-[var(--brand-soft)] px-3 py-1">HealthcareProvider</span>
        <span class="rounded-full bg-[var(--brand-soft)] px-3 py-1">Pharmacist</span>
        <span class="rounded-full bg-[var(--brand-soft)] px-3 py-1">Admin</span>
        <span class="rounded-full bg-[var(--brand-soft)] px-3 py-1">Reports</span>
      </div>
    </div>
  </aside>
</section>

<script src="../scripts/dashboard.js"></script>