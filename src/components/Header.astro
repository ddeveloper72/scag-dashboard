<header class="panel rounded-[1.75rem] px-6 py-6">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--brand-soft)] text-lg font-semibold text-[var(--brand)]">SC</div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.26em] text-[var(--brand)]">Shared Care Access Gateway</p>
            <p class="mt-1 text-sm text-[var(--text-muted)]">Secure launchpad for downstream clinical systems</p>
          </div>
        </div>
      </div>

      <nav class="flex items-center gap-2 text-sm text-[var(--text-muted)]">
        <span class="rounded-full bg-[var(--surface-muted)] px-3 py-1">Astro</span>
        <span class="rounded-full bg-[var(--surface-muted)] px-3 py-1">MSAL</span>
        <span class="rounded-full bg-[var(--surface-muted)] px-3 py-1">Entra roles</span>
      </nav>
    </div>

    <div class="brand-rule"></div>

    <div class="grid gap-6 lg:grid-cols-[1.45fr_0.8fr] lg:items-start">
      <div class="space-y-4">
        <div>
          <h1 class="text-3xl font-semibold tracking-tight text-slate-900 md:text-4xl">Simple, role-based access to shared care applications</h1>
          <p class="mt-3 max-w-3xl text-base leading-7 text-[var(--text-muted)]">
            Users authenticate with Microsoft Entra ID, the dashboard reads roles from the ID token, and only the systems relevant to that role set are exposed.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-[var(--line)] bg-[var(--surface-muted)] px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--brand)]">Authentication</p>
            <p class="mt-2 text-sm text-[var(--text-muted)]">Client-side sign-in using Microsoft Entra and MSAL Browser.</p>
          </div>
          <div class="rounded-2xl border border-[var(--line)] bg-[var(--surface-muted)] px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--brand)]">Authorization</p>
            <p class="mt-2 text-sm text-[var(--text-muted)]">App roles determine which destinations appear in the dashboard.</p>
          </div>
          <div class="rounded-2xl border border-[var(--line)] bg-[var(--surface-muted)] px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--brand)]">Routing</p>
            <p class="mt-2 text-sm text-[var(--text-muted)]">Every deep link is injected from environment variables rather than source code.</p>
          </div>
        </div>
      </div>

      <section class="rounded-[1.5rem] border border-[var(--line)] bg-[var(--surface-muted)] p-5">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--brand)]">Current session</p>
        <p class="mt-3 text-sm text-[var(--text-muted)]" id="auth-status">Checking authentication...</p>
        <p class="mt-1 text-xl font-semibold text-slate-900" id="user-name">Not signed in</p>

        <div class="mt-5 space-y-3 text-sm text-[var(--text-muted)]">
          <div class="flex items-center justify-between rounded-2xl border border-[var(--line)] bg-white px-4 py-3">
            <span>Sign-in provider</span>
            <span class="font-medium text-slate-900">Microsoft Entra ID</span>
          </div>
          <div class="flex items-center justify-between rounded-2xl border border-[var(--line)] bg-white px-4 py-3">
            <span>Access model</span>
            <span class="font-medium text-slate-900">Role-aware</span>
          </div>
        </div>

        <div class="mt-5 flex gap-3">
          <a
            class="rounded-full bg-[var(--brand)] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#0b5a9c]"
            href="/login"
            id="login-link"
          >
            Sign in
          </a>
          <a
            class="hidden rounded-full border border-[var(--line)] bg-white px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-slate-50"
            href="/logout"
            id="logout-link"
          >
            Sign out
          </a>
        </div>
      </section>
    </div>
  </div>
</header>