---
import "../styles/globals.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | SCAG Dashboard</title>
  </head>
  <body>
    <main class="shell flex min-h-screen items-center justify-center">
      <section class="w-full max-w-lg rounded-[2rem] border border-white/70 bg-white/85 p-8 text-center shadow-[0_25px_60px_-45px_rgba(15,23,42,0.4)] backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-700">Authentication</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-900">Redirecting to Microsoft Entra ID</h1>
        <p class="mt-4 text-sm leading-6 text-slate-600" id="login-message">
          Your browser will be redirected to the sign-in experience. If nothing happens, use the button below.
        </p>
        <button
          class="mt-6 rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-cyan-700"
          id="login-button"
          type="button"
        >
          Continue to sign in
        </button>
      </section>
    </main>

    <script src="../scripts/login.js"></script>
  </body>
</html>